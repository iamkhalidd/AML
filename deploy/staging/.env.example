# Staging settings. Synthetic data only.
# Keep the real file encrypted as staging.env.age (see deploy/README.md); never commit it in plain text.
AML_DOMAIN=staging.example.com
AML_IMAGE=ghcr.io/iamkhalidd/aml:main
# Three different long random values (e.g. openssl rand -base64 32):
POSTGRES_PASSWORD=CHANGE_ME
AML_APP_DB_PASSWORD=CHANGE_ME
AML_PROVISIONER_DB_PASSWORD=CHANGE_ME
# Encrypts users' second-factor secrets. Generate once and never change it, or every user
# must enrol again: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AML_MFA_KEY=CHANGE_ME
